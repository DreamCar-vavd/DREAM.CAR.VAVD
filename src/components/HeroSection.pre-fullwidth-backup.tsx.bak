import Image from "next/image";
import { MessageCircle } from "lucide-react";
import type { Dictionary } from "@/content/types";
import type { Locale } from "@/lib/i18n/config";
import { GoldLink } from "./GoldButton";
import { whatsappUrl } from "@/lib/social";

export function HeroSection({ dict, locale }: { dict: Dictionary; locale: Locale }) {
  const [word1, word2, word3] = dict.hero.tagline.split(" • ");

  return (
    <section className="relative overflow-hidden border-b border-border-gold">
      <div className="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 md:grid-cols-2 md:py-16 lg:px-8">
        <div className="order-2 flex flex-col items-start gap-6 md:order-1 animate-in">
          <Image
            src="/images/dream-car-logo.png"
            alt={`${dict.hero.title} — ${dict.hero.brandTag}`}
            width={1413}
            height={800}
            priority
            className="h-auto w-full max-w-[320px] sm:max-w-[380px]"
          />

          <div className="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
            <GoldLink href={`/${locale}#contacts`} variant="solid" className="w-full sm:w-auto">
              {dict.hero.ctaPrimary}
            </GoldLink>
            <GoldLink
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="outline"
              className="w-full sm:w-auto"
            >
              <MessageCircle size={16} aria-hidden="true" />
              {dict.hero.ctaSecondary}
            </GoldLink>
          </div>
        </div>

        <div className="relative order-1 aspect-[1725/746] w-full overflow-hidden rounded-sm md:order-2">
          <Image
            src="/images/hero-cars.png"
            alt={dict.meta.siteName}
            fill
            priority
            sizes="(min-width: 768px) 50vw, 100vw"
            className="object-cover"
          />
        </div>
      </div>

      <div className="relative border-t border-border-gold/50 bg-background/60 px-4 py-6 sm:px-6">
        <div className="mx-auto flex max-w-3xl flex-col items-center gap-2.5 text-center">
          {word1 && word2 && word3 && (
            <p className="flex flex-wrap items-center justify-center gap-3 text-sm font-semibold tracking-[0.2em] text-gold sm:text-base">
              <span>{word1}</span>
              <span className="inline-block h-1.5 w-1.5 rotate-45 bg-gold" aria-hidden="true" />
              <span>{word2}</span>
              <span className="inline-block h-1.5 w-1.5 rotate-45 bg-gold" aria-hidden="true" />
              <span>{word3}</span>
            </p>
          )}
          <p className="text-base text-text sm:text-lg">{dict.hero.subtitle}</p>
          <p className="flex items-center gap-3 text-sm text-muted sm:text-base">
            <span className="hidden h-px w-10 bg-border-gold sm:inline-block" aria-hidden="true" />
            {dict.hero.thanksLine}
            <span className="hidden h-px w-10 bg-border-gold sm:inline-block" aria-hidden="true" />
          </p>
        </div>
      </div>
    </section>
  );
}
