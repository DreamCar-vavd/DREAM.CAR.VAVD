NEXT_PUBLIC_SITE_URL=https://dream-car-vavd.com
CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# --- Панель керування контентом (/keystatic + /panel) ---
# Не задано -> у `next dev` локальний файловий режим; на деплої /keystatic,
# /panel, /api/* повертають 404.
# "github" на деплої -> hosted-панель + вхід GitHub + комміти через GitHub API.
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=
KEYSTATIC_GITHUB_REPO_OWNER=DreamCar-vavd
KEYSTATIC_GITHUB_REPO_NAME=DREAM.CAR.VAVD
# Гілка для контент-коммітів панелі. Не задано -> гілка цього деплою
# (VERCEL_GIT_COMMIT_REF), тож Preview публікує на власну гілку, не в main.
PANEL_CONTENT_BRANCH=
# З GitHub App (створює власник, докладно — docs/PANEL.md + report/35 §12).
# Лише в Environment Variables Vercel, ніколи не в репозиторії.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# --- Відео авто (/panel/video) ---
# Не задано + `next dev` -> локальне сховище public/uploads/videos/ (не в Git).
# На хостингу потрібні пакет `@vercel/blob` і `BLOB_READ_WRITE_TOKEN`
# (Vercel → Storage → Blob) — адаптер зовнішнього сховища ще не реалізований.
BLOB_READ_WRITE_TOKEN=

# --- Заявки з форми (/panel/leads) ---
# Postgres connection string (Neon / Vercel Postgres). Задано -> заявки
# зберігаються й показуються в панелі. Схема + міграція:
# src/lib/leads/schema.sql, `npm run leads:migrate`. Формат:
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Надходження листів на пошту цим НЕ керується (окремий CONTACT_FORM_ENDPOINT).
LEADS_DATABASE_URL=
#
# Поведінка /panel/leads без LEADS_DATABASE_URL:
#  - локальна розробка (next dev): демо-дані з помітним банером «тестовий режим»;
#  - hosted (production): «Сховище заявок не налаштоване» — НЕ демо.
# LEADS_DEMO_MODE=1 примусово вмикає демо-режим і в hosted (для показу інтерфейсу).
LEADS_DEMO_MODE=
