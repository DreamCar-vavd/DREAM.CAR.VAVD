NEXT_PUBLIC_SITE_URL=https://dream-car-vavd.com
CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# --- Панель керування контентом (/keystatic) ---
# Не задано -> у `next dev` панель у локальному файловому режимі; на будь-якому
# деплої маршрут /keystatic повертає 404.
# Задати "github" на деплої, щоб увімкнути hosted-панель + вхід через GitHub.
KEYSTATIC_STORAGE_KIND=
KEYSTATIC_GITHUB_REPO_OWNER=DreamCar-vavd
KEYSTATIC_GITHUB_REPO_NAME=DREAM.CAR.VAVD
# З GitHub App (створює власник, див. docs/PANEL.md). Лише в Environment
# Variables Vercel, ніколи не в репозиторії.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
